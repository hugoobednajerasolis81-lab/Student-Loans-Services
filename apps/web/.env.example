# Public PocketBase address used by the browser SDK.
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Server-only service account. Create a dedicated PocketBase users auth account
# with role=admin and permissions restricted by the collection rules in docs.
# Never prefix these values with VITE_ and never commit real credentials.
POCKETBASE_URL=http://127.0.0.1:8090
POCKETBASE_SERVICE_EMAIL=
POCKETBASE_SERVICE_PASSWORD=
PORT=3000
