const CONFIG = { casesSheet: 'Cases', eventsSheet: 'AuditLog', envelopeSheet: 'Envelopes' };
function doGet() { return json_({ ok: true, service: 'student-loans-solutions-crm', version: '0.1.0' }); }
function doPost(e) { try { const r = JSON.parse((e && e.postData && e.postData.contents) || '{}'); if (r.action === 'health') return json_({ ok: true }); if (r.action === 'createCase') return json_(createCase_(r)); if (r.action === 'createEnvelope') return json_(createEnvelope_(r)); return json_({ ok: false, error: 'Unsupported action' }); } catch (err) { audit_('error', { message: String(err && err.message || err) }); return json_({ ok: false, error: 'Request could not be processed' }); } }
function createCase_(r) { const c = r.client || {}; const name = required_(c.name, 'name'); const email = required_(c.email, 'email'); if (!/^\S+@\S+\.\S+$/.test(email)) throw new Error('Valid email required'); if (containsCredentialField_(r)) throw new Error('FSA credentials and MFA codes are not accepted'); const id = Utilities.getUuid(); const now = new Date().toISOString(); const last4 = normalizeLast4_(c.ssnLast4); appendRow_(CONFIG.casesSheet, [id, now, name, email, c.phone || '', c.topic || '', last4, 'New']); audit_('case_created', { caseId: id }); return { ok: true, caseId: id, status: 'New', createdAt: now }; }
function createEnvelope_(r) { const caseId = required_(r.caseId, 'caseId'); const agreementVersion = required_(r.agreementVersion, 'agreementVersion'); const email = required_(r.signerEmail, 'signerEmail'); if (!/^\S+@\S+\.\S+$/.test(email)) throw new Error('Valid signer email required'); const id = Utilities.getUuid(); const now = new Date().toISOString(); appendRow_(CONFIG.envelopeSheet, [id, caseId, agreementVersion, email, 'pending', now, '']); audit_('envelope_created', { caseId, envelopeId: id, agreementVersion }); return { ok: true, envelopeId: id, status: 'pending', createdAt: now }; }
function appendRow_(name, row) { const spreadsheetId = PropertiesService.getScriptProperties().getProperty('CRM_SPREADSHEET_ID'); if (!spreadsheetId) throw new Error('CRM spreadsheet is not configured'); const sheet = SpreadsheetApp.openById(spreadsheetId).getSheetByName(name); if (!sheet) throw new Error('CRM sheet is not configured: ' + name); sheet.appendRow(row); }
function audit_(event, data) { try { appendRow_(CONFIG.eventsSheet, [new Date().toISOString(), event, JSON.stringify(data)]); } catch (_) {} }
function required_(v, f) { const x = String(v || '').trim(); if (!x) throw new Error(f + ' is required'); return x; }
function normalizeLast4_(v) { const x = String(v || '').replace(/\D/g, ''); if (x && x.length !== 4) throw new Error('Only the last four digits are accepted in this endpoint'); return x; }
function containsCredentialField_(v) { const forbidden = /(fsa|studentaid|mfa|otp|one.?time|security.?code|password)/i; if (!v || typeof v !== 'object') return false; return Object.keys(v).some(k => forbidden.test(k) || containsCredentialField_(v[k])); }
function json_(x) { return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON); }
